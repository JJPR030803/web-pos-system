{
  "name": "@pos/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "k6:smoke": "docker run --rm -v $(pwd)/k6:/k6 --add-host=host.docker.internal:host-gateway grafana/k6 run /k6/scripts/smoke.js",
    "k6:load": "docker run --rm -v $(pwd)/k6:/k6 --add-host=host.docker.internal:host-gateway grafana/k6 run /k6/scripts/load-auth.js",
    "k6:spike": "docker run --rm -v $(pwd)/k6:/k6 --add-host=host.docker.internal:host-gateway grafana/k6 run /k6/scripts/spike.js",
    "k6:stress": "docker run --rm -v $(pwd)/k6:/k6 --add-host=host.docker.internal:host-gateway grafana/k6 run /k6/scripts/stress.js",
    "k6:soak": "docker run --rm -v $(pwd)/k6:/k6 --add-host=host.docker.internal:host-gateway grafana/k6 run /k6/scripts/soak.js",
    "start": "bun run src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.1",
    "@elysiajs/swagger": "^1.3.1",
    "@pos/shared": "workspace:*",
    "drizzle-orm": "^0.45.1",
    "elysia": "^1.1.29",
    "postgres": "^3.4.8"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.8"
  }
}
